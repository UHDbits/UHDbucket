{
    "version": "2026.2.1",
    "description": "Official Software Development Kit (SDK) and desktop tools for the FIRST Robotics Competition (FRC)",
    "homepage": "https://github.com/wpilibsuite/allwpilib",
    "license": "BSD-3-Clause",
    "architecture": {
        "64bit": {
            "url": "https://packages.wpilib.workers.dev/installer/v2026.2.1/Win64/WPILib_Windows-2026.2.1.iso#/wpilib.iso",
            "hash": "6dd86b714c41127c9ef7683b398dc21423cba7146e6868a97fefbd65a14429cb"
        }
    },
    "installer": {
        "script": [
            "Expand-Archive -Path \"$dir\\WPILib_Windows-$version-artifacts.zip\" -DestinationPath \"$dir\" -Force",
            "& \"$dir\\tools\\ToolsUpdater.exe\"",
            "$sb = Get-ChildItem \"$dir\\maven\\org\\wpilib\\shuffleboard\\shuffleboard-app\\*\\shuffleboard-app-*.jar\" | Select-Object -First 1",
            "if ($sb) {",
            "    $relativeJar = $sb.FullName.Substring($dir.Length + 1)",
            "    Set-Content -Path \"$dir\\shuffleboard.bat\" -Value '@echo off', ('\"%~dp0jdk\\bin\\java.exe\" -jar \"%~dp0' + $relativeJar + '\" %*')",
            "}",
            "$sd = Get-ChildItem \"$dir\\maven\\org\\wpilib\\smartdashboard\\smartdashboard-app\\*\\smartdashboard-app-*.jar\" | Select-Object -First 1",
            "if ($sd) {",
            "    $relativeJar = $sd.FullName.Substring($dir.Length + 1)",
            "    Set-Content -Path \"$dir\\smartdashboard.bat\" -Value '@echo off', ('\"%~dp0jdk\\bin\\java.exe\" -jar \"%~dp0' + $relativeJar + '\" %*')",
            "}",
            "$rb = Get-ChildItem \"$dir\\maven\\org\\wpilib\\robotbuilder\\RobotBuilder\\*\\RobotBuilder-*.jar\" | Select-Object -First 1",
            "if ($rb) {",
            "    $relativeJar = $rb.FullName.Substring($dir.Length + 1)",
            "    Set-Content -Path \"$dir\\robotbuilder.bat\" -Value '@echo off', ('\"%~dp0jdk\\bin\\java.exe\" -jar \"%~dp0' + $relativeJar + '\" %*')",
            "}",
            "$pw = Get-ChildItem \"$dir\\maven\\org\\wpilib\\pathweaver\\pathweaver-app\\*\\pathweaver-app-*.jar\" | Select-Object -First 1",
            "if ($pw) {",
            "    $relativeJar = $pw.FullName.Substring($dir.Length + 1)",
            "    Set-Content -Path \"$dir\\pathweaver.bat\" -Value '@echo off', ('\"%~dp0jdk\\bin\\java.exe\" -jar \"%~dp0' + $relativeJar + '\" %*')",
            "}",
            "Get-ChildItem -Path \"$dir\" -File | Remove-Item -Force",
            "Get-ChildItem -Path \"$dir\" -Directory | Where-Object { $_.Name -notin 'tools', 'advantagescope', 'elastic', 'jdk', 'vscode', 'maven', 'vendordeps' } | Remove-Item -Recurse -Force"
        ]
    },
    "bin": [
        [ "tools/glass.exe", "glass" ],
        [ "tools/outlineviewer.exe", "outlineviewer" ],
        [ "tools/sysid.exe", "sysid" ],
        [ "tools/datalogtool.exe", "datalogtool" ],
        [ "tools/wpical.exe", "wpical" ],
        [ "tools/roborioteamnumbersetter.exe", "roborioteamnumbersetter" ],
        [ "advantagescope/AdvantageScope (WPILib).exe", "advantagescope" ],
        [ "elastic/elastic_dashboard.exe", "elastic" ],
        [ "vscode/Code.exe", "wpilib-vscode" ],
        "shuffleboard.bat",
        "smartdashboard.bat",
        "robotbuilder.bat",
        "pathweaver.bat"
    ],
    "shortcuts": [
        [ "tools/glass.exe", "WPILib Tools\\Glass" ],
        [ "tools/outlineviewer.exe", "WPILib Tools\\OutlineViewer" ],
        [ "tools/sysid.exe", "WPILib Tools\\SysId" ],
        [ "tools/datalogtool.exe", "WPILib Tools\\Data Log Tool" ],
        [ "tools/wpical.exe", "WPILib Tools\\WPIcal" ],
        [ "tools/roborioteamnumbersetter.exe", "WPILib Tools\\RoboRIO Team Number Setter" ],
        [ "advantagescope/AdvantageScope (WPILib).exe", "WPILib Tools\\AdvantageScope" ],
        [ "elastic/elastic_dashboard.exe", "WPILib Tools\\Elastic" ],
        [ "vscode/Code.exe", "WPILib VS Code" ],
        [ "shuffleboard.bat", "WPILib Tools\\Shuffleboard" ],
        [ "smartdashboard.bat", "WPILib Tools\\SmartDashboard" ],
        [ "robotbuilder.bat", "WPILib Tools\\RobotBuilder" ],
        [ "pathweaver.bat", "WPILib Tools\\PathWeaver" ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://packages.wpilib.workers.dev/installer/v$version/Win64/WPILib_Windows-$version.iso#/wpilib.iso"
            }
        },
        "hash": {
            "url": "https://api.github.com/repos/wpilibsuite/allwpilib/releases/latest",
            "regex": "([a-fA-F0-9]{64})\\s+Win64/\\$basename"
        }
    }
}
